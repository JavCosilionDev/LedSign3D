{
  "name": "ledsign3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Convierte SVG monocromático en modelos 3D (STL) imprimibles para letreros LED tipo letra canal (base + tapa + panel difusor) con encastres click.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cavalier-contours-js": "^0.1.1",
    "manifold-3d": "^3.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
